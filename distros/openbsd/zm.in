#!/bin/ksh

daemon="@CMAKE_INSTALL_FULL_BINDIR@/zmpkg.pl"
daemon_flags=""

# Source function library.
. /etc/rc.d/rc.subr

rc_bg=YES
rc_reload=NO

rc_check() {
        pgrep -T "${daemon_rtable}" -q -xf "@PERL_EXECUTABLE@ -wT @CMAKE_INSTALL_FULL_BINDIR@/zmdc.pl startup"
}

rc_stop() {
        rc_exec "${daemon} stop"
}

rc_start() {
        rc_exec "${daemon} start"
}

rc_cmd $1
